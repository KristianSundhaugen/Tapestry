{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git rebase*)",
      "Bash(git push -u origin*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push)",
      "Bash(git worktree*)",
      "Bash(gh pr*)",
      "Bash(gh api*)",
      "Bash(gh auth status*)",
      "Bash(scripts/*)",
      "Bash(semgrep*)",
      "Bash(gitleaks*)",
      "Bash(trivy*)",
      "Bash(git pull --ff-only*)",
      "Bash(git push origin HEAD:*)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git stash*)",
      "Bash(gh issue*)",
      "Bash(gh repo view*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git fetch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git switch*)",
      "PowerShell(git checkout -b*)",
      "PowerShell(git rebase*)",
      "PowerShell(git push -u origin*)",
      "PowerShell(git push --force-with-lease*)",
      "PowerShell(git push)",
      "PowerShell(git worktree*)",
      "PowerShell(gh pr*)",
      "PowerShell(gh api*)",
      "PowerShell(gh auth status*)",
      "PowerShell(semgrep*)",
      "PowerShell(gitleaks*)",
      "PowerShell(trivy*)",
      "PowerShell(git pull --ff-only*)",
      "PowerShell(git push origin HEAD:*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git branch*)",
      "PowerShell(git show*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git stash*)",
      "PowerShell(gh issue*)",
      "PowerShell(gh repo view*)",
      "PowerShell(./scripts/*.ps1*)",
      "PowerShell(.\\scripts\\*.ps1*)",
      "Bash(claude -p *)",
      "PowerShell(claude -p *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf /*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -fd*)",
      "PowerShell(Remove-Item -Recurse -Force C:\\*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
